# 复制本文件为 .env，并填入真实 key
DEEPSEEK_API_KEY=你的API key，不要上传

# —— 可选：PPT 的 AI 配图（SiliconFlow，一个 key 聚合 FLUX/Kolors 等图模型，按量付费）——
# 不填则 PPT 回退为纯矢量装饰，其余功能不受影响
SILICONFLOW_API_KEY=你的SiliconFlow key，不要上传
# SILICONFLOW_MODEL=Kwai-Kolors/Kolors
# SILICONFLOW_IMAGE_SIZE=1024x576
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1/images/generations
